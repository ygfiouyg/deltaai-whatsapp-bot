# DeltaAI WhatsApp Bot — Environment Variables
# On Glitch, set these in the .env file (it's auto-hidden and secure)

# Required: Your DeltaAI server URL
DELTA_AI_URL=https://kopabdo-delta-ai.hf.space

# Optional: Bot settings
BOT_NAME=DeltaAI
BOT_LANGUAGE=ar
DEFAULT_MODEL=delta-general

# Optional: Rate limiting (messages per minute per user)
RATE_LIMIT_PER_MINUTE=10

# Optional: Admin phone numbers (comma-separated, with country code)
# ADMIN_NUMBERS=201234567890

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

# PORT is automatically set by Glitch/Render — don't change it
# PROJECT_DOMAIN is automatically set by Glitch — don't change it
