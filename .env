# DeltaAI WhatsApp Bot — Environment Variables
# On Termux, edit this file with: nano .env

# Required: Your DeltaAI server URL
DELTA_AI_URL=https://kopabdo-delta-ai.hf.space

# Required: Your WhatsApp number with country code (NO + sign!)
# Example for Egypt: 201234567890
# This enables the Pairing Code method (no QR scan needed!)
PHONE_NUMBER=

# Optional: Bot settings
BOT_NAME=DeltaAI
BOT_LANGUAGE=ar
DEFAULT_MODEL=delta-flash

# Optional: Rate limiting (messages per minute per user)
RATE_LIMIT_PER_MINUTE=10

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info
